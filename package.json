    "lint": "prettier --check . && eslint",
    "typecheck": "tsc",
    "build": "pkgroll"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@types/dedent": "^0.7.2",
    "@types/ini": "^1.3.31",
    "@types/node": "^18.15.11",
    "@typescript-eslint/eslint-plugin": "^5.57.1",
    "@typescript-eslint/parser": "^5.57.1",
    "eslint": "^8.38.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "jiti": "^1.17.0",
    "pkgroll": "^2.28.1",
    "prettier": "^2.8.8",
    "typescript": "5.9.2"
  }
}
