{
  "name": "@arcasilesgroup/ai-shell",
  "description": "A CLI that converts natural language to shell commands, with any OpenAI-compatible provider.",
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@clack/core": "1.4.3",
    "@clack/prompts": "1.7.0",
    "@dqbd/tiktoken": "^1.0.22",
    "@nexssp/os": "2.0.36",
    "axios": "^1.3.5",
    "cleye": "^2.6.0",
    "clipboardy": "^2.3.0",
    "dedent": "^1.7.2",
    "execa": "^7.1.1",
    "i18next": "^26.4.0",
    "ini": "^4.0.0",
    "kolorist": "^1.8.0",
    "openai": "^7.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcasilesgroup/ai-shell.git"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "ai": "dist/cli.mjs",
    "ai-shell": "dist/cli.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "jiti ./src/cli.ts",
